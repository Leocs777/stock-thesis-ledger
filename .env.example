# Optional provider credentials. Leave blank to run without provider-backed data.
ALPHAVANTAGE_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Local server and storage defaults.
INVESTORLAB_DB=data/investor-lab.sqlite3
INVESTORLAB_HOST=127.0.0.1
INVESTORLAB_PORT=8000
INVESTORLAB_ALLOW_REGISTRATION=0
INVESTORLAB_SECURE_COOKIE=0
INVESTORLAB_PUBLIC_URL=
INVESTORLAB_ACCESS_GATEWAY=
INVESTORLAB_TRUST_PROXY=0

# Use a monitored address when requesting public SEC EDGAR data.
INVESTORLAB_SEC_CONTACT=you@example.com

# Cost and collection controls.
INVESTORLAB_MARKET_CACHE_MINUTES=720
INVESTORLAB_MARKET_HISTORY=compact
INVESTORLAB_ADJUSTED_DAILY=0
INVESTORLAB_INTRADAY_COLLECTION=0
INVESTORLAB_INTRADAY_SYMBOL_LIMIT=8
INVESTORLAB_OPTION_COLLECTION=0
INVESTORLAB_BACKUP_RETENTION=30
